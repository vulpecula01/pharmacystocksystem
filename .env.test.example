# ไฟล์สำหรับทดสอบระบบ (Test/Staging) - ใช้คนละพอร์ตและคนละฐานข้อมูลกับของจริงเสมอ
# คัดลอกเป็น .env.test แล้วแก้ค่าให้ตรงกับเซิร์ฟเวอร์ทดสอบ
PORT=6501
NODE_ENV=test

# ต้องเป็นคนละฐานข้อมูลกับ production เด็ดขาด (ป้องกันข้อมูลทดสอบไปปนกับของจริง)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacy_stock_test
DB_USER=pharmacy_app
DB_PASSWORD=เปลี่ยนเป็นรหัสผ่านของฐานข้อมูล test

SESSION_SECRET=ใช้ค่าอื่นที่ไม่ซ้ำกับ-production

NEAR_EXPIRY_DAYS=90

# ผู้ช่วยถามข้อมูล Stock - โหมดฟรี (จับคำสำคัญ) ทำงานได้เลยไม่ต้องตั้งค่าอะไรเพิ่ม
# ถ้าต้องการเปิดโหมด Claude API เสริม (มีค่าใช้จ่าย) ให้ใส่ค่าเดียวกับ production ได้
# ANTHROPIC_API_KEY=ใส่-API-Key-ของคุณที่นี่
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
