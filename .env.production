# ไฟล์สำหรับใช้งานจริง (Production)
# คัดลอกเป็น .env.production แล้วแก้ค่าให้ตรงกับเซิร์ฟเวอร์จริง
PORT=6500
NODE_ENV=production

# ฐานข้อมูลจริงที่ใช้งานประจำวัน (ห้ามใช้ร่วมกับฐานข้อมูล test)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacy_stock
DB_USER=anurak
DB_PASSWORD=@Nurak@12345

# ต้องเปลี่ยนเป็นค่าสุ่มที่ไม่ซ้ำใคร (ใช้สำหรับเข้ารหัส session cookie)
SESSION_SECRET=เปลี่ยนเป็นข้อความสุ่มยาวๆ-ห้ามซ้ำกับ-test

# จำนวนวันก่อนหมดอายุที่ถือว่า Near Expired
NEAR_EXPIRY_DAYS=90

SSL_CERT_PATH=certs/server.crt
SSL_KEY_PATH=certs/server.key
HTTPS_PORT=6543