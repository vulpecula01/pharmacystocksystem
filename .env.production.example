# ไฟล์สำหรับใช้งานจริง (Production)
# คัดลอกเป็น .env.production แล้วแก้ค่าให้ตรงกับเซิร์ฟเวอร์จริง
PORT=6500
NODE_ENV=production

# ฐานข้อมูลจริงที่ใช้งานประจำวัน (ห้ามใช้ร่วมกับฐานข้อมูล test)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacy_stock
DB_USER=pharmacy_app
DB_PASSWORD=เปลี่ยนเป็นรหัสผ่านจริงที่ปลอดภัย

# ต้องเปลี่ยนเป็นค่าสุ่มที่ไม่ซ้ำใคร (ใช้สำหรับเข้ารหัส session cookie)
SESSION_SECRET=เปลี่ยนเป็นข้อความสุ่มยาวๆ-ห้ามซ้ำกับ-test

# จำนวนวันก่อนหมดอายุที่ถือว่า Near Expired
NEAR_EXPIRY_DAYS=90

# ผู้ช่วยถามข้อมูล Stock (เมนู "ผู้ช่วย") - โหมดค้นหาแบบจับคำสำคัญทำงานได้ฟรีทันทีโดยไม่ต้องตั้งค่าอะไรเพิ่ม
# ถ้าต้องการให้เข้าใจคำถามที่ซับซ้อน/ยืดหยุ่นกว่าเดิม (ใช้ Claude API แทน มีค่าใช้จ่าย) ให้ใส่ค่า 2 บรรทัดนี้เพิ่ม
# (ขอ API Key จาก https://console.anthropic.com และเปิด Firewall ให้ยิง HTTPS ไปยัง api.anthropic.com ได้)
# ANTHROPIC_API_KEY=ใส่-API-Key-ของคุณที่นี่
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# HTTPS (จำเป็นสำหรับหน้า "คนขับ" ของระบบติดตามการส่งยา - เบราว์เซอร์บังคับต้องเป็น HTTPS ถึงจะส่งพิกัด GPS ได้)
# ใส่ค่า 3 บรรทัดนี้เพื่อเปิดใช้ HTTPS (ไฟล์ certs/server.crt และ certs/server.key ที่แนบมาให้ออกสำหรับ IP 10.121.111.233 โดยเฉพาะ)
# เมื่อเปิดใช้แล้ว ลิงก์เดิม http://10.121.111.233:6500 จะเด้งไป https://10.121.111.233:6543 ให้อัตโนมัติ
SSL_CERT_PATH=certs/server.crt
SSL_KEY_PATH=certs/server.key
HTTPS_PORT=6543
