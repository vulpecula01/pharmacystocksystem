<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/nav') %>
<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-arrow-left-right"></i> รายการ Transfer</h4>
    <a href="/transfers/new" class="btn btn-success btn-sm"><i class="bi bi-plus-lg"></i> สร้าง Transfer ใหม่</a>
  </div>

  <div class="card mb-3">
    <div class="card-body d-flex gap-2 flex-wrap">
      <select id="statusFilter" class="form-select form-select-sm" style="width:180px">
        <option value="">-- ทุกสถานะ --</option>
        <option value="DRAFT">Draft</option>
        <option value="TRANSFER_PENDING">รอรับสินค้า</option>
        <option value="RECEIVED">รับสินค้าแล้ว</option>
        <option value="CANCELLED">ยกเลิก</option>
      </select>
      <button class="btn btn-outline-secondary btn-sm" id="refreshBtn"><i class="bi bi-arrow-clockwise"></i> รีเฟรช</button>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr><th>เลขที่</th><th>จาก</th><th>ถึง</th><th>จำนวนรายการ</th><th>สถานะ</th><th>สร้างโดย</th><th>วันที่สร้าง</th><th></th></tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/common.js"></script>
<script src="/js/transfers-list.js"></script>
</body>
</html>
