<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/nav') %>
<div class="container-fluid py-3">
  <h4 class="mb-3"><i class="bi bi-file-earmark-bar-graph"></i> รายงาน</h4>

  <ul class="nav nav-tabs mb-3" id="reportTabs">
    <li class="nav-item"><a class="nav-link active" data-type="movement" href="#">รับเข้า/จ่ายออก/Transfer (Stock Movement)</a></li>
    <li class="nav-item"><a class="nav-link" data-type="transfers" href="#">รายงาน Transfer</a></li>
    <li class="nav-item"><a class="nav-link" data-type="stock-balance" href="#">Stock คงเหลือ</a></li>
    <li class="nav-item"><a class="nav-link" data-type="stock-by-lot" href="#">Stock แยกตาม Lot</a></li>
    <li class="nav-item"><a class="nav-link" data-type="near-expiry" href="#">Near Expiry / Expired</a></li>
  </ul>

  <div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small">Store</label>
        <select id="storeFilter" class="form-select form-select-sm"><option value="">-- ทุก Store --</option></select>
      </div>
      <div class="col-md-2" id="typeFilterWrap">
        <label class="form-label small">ประเภท</label>
        <select id="typeFilter" class="form-select form-select-sm">
          <option value="">-- ทั้งหมด --</option>
          <option value="RECEIVE">รับเข้า (Adjustment+)</option>
          <option value="ISSUE">จ่ายออก</option>
          <option value="TRANSFER_IN">Transfer เข้า</option>
          <option value="TRANSFER_OUT">Transfer ออก</option>
          <option value="ADJUSTMENT">ปรับปรุง</option>
        </select>
      </div>
      <div class="col-md-2" id="fromWrap"><label class="form-label small">จากวันที่</label><input type="date" id="fromDate" class="form-control form-control-sm"></div>
      <div class="col-md-2" id="toWrap"><label class="form-label small">ถึงวันที่</label><input type="date" id="toDate" class="form-control form-control-sm"></div>
      <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" id="filterBtn">กรองข้อมูล</button></div>
      <div class="col-md-1"><button class="btn btn-sm btn-outline-success w-100" id="exportBtn"><i class="bi bi-download"></i></button></div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0" id="reportTable">
          <thead class="table-light"><tr id="theadRow"></tr></thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/common.js"></script>
<script src="/js/reports.js"></script>
</body>
</html>
